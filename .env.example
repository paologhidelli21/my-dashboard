# Hash della password della dashboard in formato scrypt (scrypt:salt:hash).
# Genera il tuo hash con: npm run generate:hash -- "la-tua-password"
# Poi copia questo file in .env e incolla il valore.
DASHBOARD_PASSWORD_HASH=

# Porta del server (opzionale, default 8787)
PORT=8787

# Cookie "Secure" solo via HTTPS. Default: attivo quando NODE_ENV=production.
# Imposta a 0 solo se servi la dashboard in produzione via HTTP semplice.
# COOKIE_SECURE=0
